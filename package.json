{
  "name": "usestore-ts",
  "version": "0.0.3",
  "description": "usestore-ts - React state management library",
  "keywords": [
    "usestore-ts"
  ],
  "author": "Seedwhale",
  "license": "MIT",
  "homepage": "https://github.com/ahastudio/usestore-ts",
  "bugs": "https://github.com/ahastudio/usestore-ts/issues",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "build:cjs": "tsc -p tsconfig.cjs.json --outDir dist/cjs",
    "build:esm": "tsc -p tsconfig.esm.json --outDir dist/esm",
    "check": "tsc --noEmit",
    "lint": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
    "test": "jest",
    "coverage": "jest --coverage --coverage-reporters html",
    "watch:test": "jest --watchAll"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20"
  }
}
